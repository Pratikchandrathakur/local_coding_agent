# ---------------------------------------------------------------------------
# LOCAL CODING AGENT CONFIGURATION
# ---------------------------------------------------------------------------

# Model selection from Hugging Face
MODEL_REPO=bartowski/Ornith-1.5-35B-A3B-GGUF
MODEL_FILE=Ornith-1.5-35B-A3B-IQ3_M.gguf
MODEL_ALIAS=local-coder

# Port for the OpenAI-compatible API server
PORT=8080

# GPU Offloading (99 = all attention blocks on GPU)
GPU_LAYERS=99

# Context window size in tokens (32768, 65536, 131072)
CONTEXT_SIZE=131072

# KV Cache precision (f16 recommended for hybrid MoE)
KV_CACHE_QUANT=f16
FLASH_ATTN=on

# MoE Expert Offloading to System RAM
EXTRA_ARGS="--n-cpu-moe 12"

# Sampling Parameters
TEMPERATURE=0.3
TOP_P=0.95
TOP_K=20

